classDiagram
    direction LR

    class Usuario {
        -Long id
        -String email
        -String senha
    }

    class Cliente {
        -String nome
        -String telefone
    }

    class Profissional {
        -String nome
        -String especialidade
        +estaDisponivel(inicio, fim) boolean
    }

    class Servico {
        -Long id
        -String nome
        -int duracaoMinutos
        -BigDecimal preco
        -boolean ativo
    }

    class Disponibilidade {
        -long id
        -DayOfWeek diaSemana
        -LocalTime horaInicio
        -LocalTime horaFim
        +contem(inicio, fim) boolean
    }

    class Agendamento {
        -Long id
        -LocalDateTime inicio
        -LocalDateTime fim
        -BigDecimal valor
        -StatusAgendamento statusAgendamento
        +podeCancelar(agora) boolean
        +cancelar(agora) void
        +marcarConcluido() void
        +marcarFalta() void
    }

    class StatusAgendamento {
        <<enumeration>>
        AGENDADO
        CONCLUIDO
        CANCELADO
        FALTOU
    }

    Usuario <|-- Cliente
    Usuario <|-- Profissional
    Profissional "1" *-- "0..*" Disponibilidade : disponibilidades
    Profissional "1" --> "0..*" Servico : servicos
    Cliente "1" --> "0..*" Agendamento : agendamentos
    Servico "1" --> "0..*" Agendamento : agendamentos
    Agendamento --> StatusAgendamento
