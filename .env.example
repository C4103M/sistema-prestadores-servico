# Banco de dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=agendamento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_NAME=agendamento_db
DB_USER=postgres
DB_PASSWORD=postgres

# Backend Spring Boot
BACKEND_PORT=8080
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
APP_SEED_ENABLED=true
APP_UPLOAD_DIR=./uploads

# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=

# Frontend (Docker / Nginx e Vite)
FRONTEND_PORT=3000
VITE_API_URL=/api

# Dica: caso as portas padrao (5432, 8080, 3000) estejam ocupadas por outro projeto,
# defina DB_PORT=5433, BACKEND_PORT=8081 e FRONTEND_PORT=3001 ao subir com docker compose.
